{
  "name": "cipherkeep-firefox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "contrast:check": "node scripts/check-contrast.mjs",
    "compat:run": "node scripts/compat-run.mjs",
    "compat:dashboard": "node scripts/build-compat-dashboard.mjs",
    "compat:check": "node scripts/check-compat.mjs",
    "compat:all": "npm run compat:run && npm run compat:dashboard && npm run compat:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:wasm-session": "node scripts/session-smoke.cjs",
    "lint": "node scripts/lint-extension.mjs",
    "scan:csp": "node scripts/check-csp.mjs",
    "build:xpi": "node scripts/pack-xpi.mjs",
    "release:manifest": "node scripts/update-manifest.mjs",
    "release:updates": "node scripts/updates-json.mjs",
    "release:verify": "node scripts/verify-updates.mjs",
    "check": "npm run typecheck && npm run tokens:check && npm run contrast:check && npm run build && npm test && npm run test:wasm-session && npm run scan:csp && npm run lint"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "playwright": "^1.55.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
