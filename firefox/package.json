{
  "name": "cipherkeep-firefox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:wasm-session": "node scripts/session-smoke.cjs",
    "lint": "web-ext lint --source-dir dist --self-hosted",
    "scan:csp": "node scripts/check-csp.mjs",
    "build:xpi": "web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest",
    "check": "npm run typecheck && npm run build && npm test && npm run test:wasm-session && npm run scan:csp && npm run lint"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  }
}
