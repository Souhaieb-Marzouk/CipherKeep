      "slow": {
        "$type": "duration",
        "$value": "300ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          0,
          1
        ]
      }
    },
    "reducedMotion": {
      "duration": {
        "$type": "duration",
        "$value": "0ms"
      },
      "policy": {
        "$type": "string",
        "$value": "When prefers-reduced-motion is reduce, or Android animator duration scale is 0, all transitions collapse to instant and non-essential animation is removed. Progress indicators may remain."
